# ─────────────────────────────────────────────
# Kapaat — environment configuration
# Copy this file to .env and fill in your values.
# .env is never committed; this file is safe to commit.
# ─────────────────────────────────────────────

# Public-facing URL used to build QR code deep-links.
# Must be reachable from phones on your local network (or the internet if exposed).
# Example: http://192.168.1.10:8096  or  https://bins.example.com
BASE_URL=http://localhost:8096

# UI language code — must match a file in locales/ (e.g. en, fr).
LOCALE=en

# Maximum photo upload size in bytes (default 20 MB).
# MAX_PHOTO_BYTES=20971520

# Optional: n8n webhook URL for Google Sheets sync.
# Leave blank (or remove the line) to disable all webhook calls.
N8N_WEBHOOK_URL=

# Optional: shared secret validated on incoming /api/sync-row requests from n8n.
N8N_WEBHOOK_SECRET=

# Optional: path to a CA bundle for private TLS certs on your n8n host.
# N8N_CA_BUNDLE=/path/to/ca.pem

# Paths inside the container — change only if you remap the Docker volume.
DB_PATH=/data/garage_inventory.db
PHOTOS_DIR=/data/photos

# Display name shown in the browser tab and API docs.
APP_TITLE=Kapaat

# Timezone (used for timestamps).
TZ=America/New_York

# [OPTIONAL] Authentik OIDC Configuration
# If AUTHENTIK_CLIENT_ID is supplied, native OIDC authentication routes will lock down the app.
# If left blank, Kapaat runs in standard single-user local household mode.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER_URL=

# REQUIRED — generate a random secret before first run:
#   openssl rand -base64 32
# The app refuses to start if this is left blank or at the default value.
AUTH_SECRET_KEY=

# [OPTIONAL] Service API key for machine-to-machine access (scripts, n8n, automation).
# When set, pass as: Authorization: Bearer <key>  or  X-API-Key: <key>
# When unset, require_read routes are open (backward-compatible) and a WARNING is logged at startup.
SERVICE_API_KEY=

# Comma-separated scopes granted to SERVICE_API_KEY: read, write, admin (default: read,write)
# SERVICE_API_SCOPES=read,write

# ─── MFA (email OTP) ───────────────────────────────────────────────────────
# Backend: log (prints to stdout — dev only), sendgrid, or smtp
MFA_EMAIL_BACKEND=log
MFA_FROM_EMAIL=kapaat@example.com

# SendGrid (when MFA_EMAIL_BACKEND=sendgrid):
# MFA_SENDGRID_API_KEY=

# SMTP (when MFA_EMAIL_BACKEND=smtp):
# MFA_SMTP_HOST=localhost
# MFA_SMTP_PORT=587
# MFA_SMTP_USER=
# MFA_SMTP_PASSWORD=

# [OPTIONAL] Set a secret passphrase to enable AES-256 on-disk encryption via SQLCipher.
# Requires pysqlcipher3 with libsqlcipher-dev, or the ENABLE_SQLCIPHER=1 Docker build arg.
# WARNING: If you lose this key, you lose access to your data — there is no recovery.
# The app refuses to start if this is set but pysqlcipher3 is not installed.
# Leave blank (default) to use standard unencrypted SQLite.
DB_ENCRYPTION_KEY=
