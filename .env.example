# ── Required ─────────────────────────────────────────────────────────────────
# Where people open Kapaat. Used in QR labels and email links. No trailing slash.
BASE_URL=http://kapaat.local:8099
# Random secret for sessions:   openssl rand -base64 48
SECRET_KEY=
# Postgres password (any random string):   openssl rand -hex 24
POSTGRES_PASSWORD=

# Set to true when Kapaat is served over HTTPS (recommended; passkeys need it)
COOKIE_SECURE=false
KAPAAT_PORT=8099

# ── Sign-in by email code ────────────────────────────────────────────────────
# "log" prints codes to `docker compose logs api` (fine for trying it out); "smtp" sends email.
MAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kapaat <kapaat@example.com>
SMTP_STARTTLS=true

# The first person to sign in becomes admin. Pin it to your address so nobody else can claim it.
ADMIN_EMAIL=
# Let anyone with an email address create an account (otherwise admins invite people).
OPEN_SIGNUP=false

# ── Optional: single sign-on (Authentik, Keycloak, Google, …) ────────────────
# Redirect URI to register with your provider: ${BASE_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Single sign-on
# Members of this group (from the "groups" claim) become Kapaat admins.
OIDC_ADMIN_GROUP=

# ── Optional: passkeys ───────────────────────────────────────────────────────
# Set to the hostname in BASE_URL (e.g. kapaat.example.com). Requires HTTPS (or localhost).
WEBAUTHN_RP_ID=

TZ=UTC
