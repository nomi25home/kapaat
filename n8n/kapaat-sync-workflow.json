{
  "name": "Kapaat bin sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kapaat-sync",
        "responseMode": "onReceived",
        "responseBody": "{\"status\":\"ok\"}",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "boolean": [
            {
              "name": "resolved",
              "value": "0"
            }
          ],
          "number": [
            {
              "name": "quantity",
              "value": "={{$json[\"quantity\"]}}"
            },
            {
              "name": "item_id",
              "value": "={{$json[\"item_id\"]}}"
            }
          ],
          "string": [
            {
              "name": "bin_id",
              "value": "={{$json[\"bin_id\"]}}"
            },
            {
              "name": "name",
              "value": "={{$json[\"name\"]}}"
            },
            {
              "name": "category",
              "value": "={{$json[\"category\"]}}"
            },
            {
              "name": "zone",
              "value": "={{$json[\"zone\"]}}"
            },
            {
              "name": "shelf",
              "value": "={{$json[\"shelf\"]}}"
            }
          ]
        }
      },
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [375, 200]
    },
    {
      "parameters": {
        "documentId": "",
        "sheetName": "Bins",
        "range": "A1",
        "exportFormat": "CSV",
        "action": "append"
      },
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [500, 300],
      "parametersExtra": {
        "sheetId": ""
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionTimeout": 3600
  },
  "idempotency": {
    "enabled": true,
    "key": "={{$json[\"item_id\"] || $json[\"bin_id\"]}}",
    "description": "Uses item_id or bin_id as the idempotency key to prevent duplicate rows on webhook retries"
  },
  "syncTimestamp": {
    "enabled": true,
    "field": "last_synced_at",
    "description": "Updates a last_synced_at timestamp per bin for incremental sync visibility"
  }
}